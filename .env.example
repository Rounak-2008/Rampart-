# ==============================================================================
# RAMPART — Environment Configuration Example
# ==============================================================================
# Copy this file to .env (or backend/.env) and fill in your values.
# NEVER commit your actual .env file or GitHub tokens to source control!
# ==============================================================================

# [Database Configuration]
# Absolute or relative path to the SQLite database.
# Default: backend/rampart.db
RAMPART_DB_PATH=backend/rampart.db

# [GitHub API Authentication]
# A GitHub Personal Access Token (classic or fine-grained) used for repository
# synchronization, live PR diff fetching, and rate-limit headroom.
# Required scopes: repo, read:org, user:email
# Example: ghp_yourSecretTokenHere1234567890
GITHUB_TOKEN=

# [GitHub Webhook Verification]
# Shared secret string configured in your GitHub Repository Webhooks settings.
# Used by RAMPART to compute and verify HMAC SHA-256 request signatures.
# Example: rampart-webhook-secret-key-replace-in-production
RAMPART_WEBHOOK_SECRET=rampart-shared-secret-key

# [Local Gemma AI / Ollama Configuration]
# The endpoint for your locally running Ollama instance (OpenAI-compatible /v1).
# RAMPART keeps all AI inference 100% local — no source code is sent to cloud APIs.
LOCAL_LLM_URL=http://127.0.0.1:11434/v1

# The local Ollama model identifier.
# RAMPART is optimized for Gemma 4 E4B on Apple Silicon / MLX runner.
LOCAL_LLM_MODEL=gemma4:e4b
